# Xcode
build/
DerivedData/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
xcuserdata/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved
# ...except the app package's, which must be tracked: without it a clean checkout
# floats to whatever resolves that day and stops compiling.
!/FoxSayPackage/Package.resolved

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# User-specific xcodeproj data
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Xcode workspace data
*.xcworkspace/xcuserdata/

# Downloaded ML models (at runtime)
# Anchored to the repo root: an unanchored "models/" also matches
# FoxSayPackage/Sources/FoxSayFeature/Models/ (case-insensitive), which
# silently kept those sources out of the repo.
*.mlmodelc/
huggingface/
/models/

# Test directories and artifacts
# Anchored: an unanchored "tests/" also matches FoxSayPackage/Tests/.
/tests/
*.tar.bz2
*.tar.gz

# Rust build artifacts (if any tests use Rust)
target/
Cargo.lock

# Environment and secrets
.env
.env.local
*.pem
*.key

# Sparkle signing keys (KEEP THESE SECRET!)
.sparkle-keys/

# Wrangler local state (R2 uploads during release)
.wrangler/
